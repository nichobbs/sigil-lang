{
  "name": "sigil-lang",
  "version": "0.0.1",
  "private": true,
  "description": "Sigil: spike of a language designed for AI agents (verifiable, capability-secure, token-efficient).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sigil": "tsx src/cli.ts",
    "check": "tsx src/cli.ts check examples/invoicing",
    "verify": "tsx src/cli.ts verify examples/invoicing",
    "compare": "tsx src/cli.ts compare examples/invoicing",
    "docs:build": "esbuild apps/docs/src/browser.ts --bundle --format=iife --loader:.sigil=text --outfile=apps/docs/web/app.js --log-level=warning",
    "docs:serve": "tsx apps/docs/src/server.ts",
    "docs:e2e": "npm run -s docs:build && tsx apps/docs/test/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "gpt-tokenizer": "^2.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "z3-solver": "^5.3.3"
  }
}
