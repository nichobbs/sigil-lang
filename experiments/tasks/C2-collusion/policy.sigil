; Human-owned policy for the card vault (Extension 4, C2). Two approved yes/no releases over the same card field.
(policy
  (allow audit)
  (sink audit (accepts internal))
  (declassify card-at-least
    (from pii) (to internal)
    (reason "Fraud tooling may ask whether a card is at or above a probe value; the answer is one bit.")
    (max-bits 1))
  (declassify card-bit
    (from pii) (to internal)
    (reason "Card-network tooling may ask for one bit of the card number; the answer is one bit.")
    (max-bits 1)))
