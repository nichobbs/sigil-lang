; Glossary for A3: binds the business phrases in intent.feature to typed fixtures and assertions.
; It uses the types and functions named in README.md (Plan, Request, State, Decision, Rejection, Reason,
; allowance, admit), so those names are fixed.

(glossary

  ; ---- Given ------------------------------------------------------------------
  (given "a {plan:Plan} request costing {cost:Int} tokens"
    (set plan plan)
    (set cost cost))

  (given "the window started at {start:Int} ms with {used:Int} tokens used"
    (set start start)
    (set used used))

  (given "the request arrives at {now:Int} ms"
    (set now now))

  ; ---- When -------------------------------------------------------------------
  (when "the request is made"
    (call result admit (Request 4242 plan cost now) (State start used false)))

  ; ---- Then -------------------------------------------------------------------
  (then "the request is allowed with {n:Int} tokens remaining"
    (expect (match result (ok d (and (= d.remaining n) (not d.burst))) (err e false))))

  (then "the request is allowed using the burst"
    (expect (match result (ok d d.burst) (err e false))))

  (then "the request is denied and may retry in {n:Int} seconds"
    (expect (match result (ok d false) (err e (and (= e.reason Denied) (= e.retryAfter n))))))

  (then "the request is too large"
    (expect (match result (ok d false) (err e (and (= e.reason TooLarge) (= e.retryAfter 0))))))

  (then "the window state is stored once, started at {s:Int} ms with {u:Int} tokens used"
    (expect (= (len (stored store:limits)) 1))
    (expect (= (map (stored store:limits) (fn (x) x.start)) (list s)))
    (expect (= (map (stored store:limits) (fn (x) x.used)) (list u))))

  (then "nothing is stored"
    (expect (= (len (stored store:limits)) 0)))

  (then "an audit event records the request as admitted"
    (expect (= (len (emitted audit)) 1))
    (expect (= (map (emitted audit) (fn (e) e.plan)) (list plan))))

  (then "an audit event records the request as refused"
    (expect (= (len (emitted audit)) 1))
    (expect (= (map (emitted audit) (fn (e) e.cost)) (list cost))))

  ; ---- Rules, properties and privacy -------------------------------------------
  (rule "Each plan has a token allowance per window" allowance (Plan Int))

  (always "Time is counted in whole milliseconds. Windows are fixed and last 60 seconds. A window starts at the time of the request that opens it. A request that arrives 60 seconds or more after the start of the current window opens a new window, with nothing used and the burst unused; exactly 60 seconds after the start is already a new window. A request that arrives earlier belongs to the current window."
    (forall ((p Plan) (c Cost) (s (Int 0 1000000000)) (k (Int 0 1000000)) (u Tokens) (b Bool))
      (match (admit (Request 1 p c (add s (add 60000 k))) (State s u b))
        (ok d (and (<= c (allowance p)) (= d.remaining (sub (allowance p) c)) (not d.burst)))
        (err e (and (= e.reason TooLarge) (> c (allowance p)))))))

  (always "A request is allowed when the tokens already used in its window plus its cost do not exceed the plan's allowance; exactly the allowance is allowed. An allowed request adds its cost to the tokens used in the window. The answer reports the tokens remaining, which is the allowance minus the tokens used after the request, and is never below zero."
    (forall ((c (Int 1 150)) (s (Int 0 1000000000)) (k (Int 0 59999)) (u (Int 0 150)) (b Bool))
      (match (admit (Request 1 Free c (add s k)) (State s u b))
        (ok d (and (<= (add u c) (allowance Free)) (= d.remaining (sub (allowance Free) (add u c))) (not d.burst)))
        (err e (or (> c (allowance Free)) (> (add u c) (allowance Free)))))))

  (always "A request whose cost alone exceeds the plan's allowance is rejected as too large, whatever has been used in the window and whatever burst is available. A request that is too large consumes nothing, and its retry-after is 0."
    (forall ((p Plan) (c (Int 1 20000)) (s (Int 0 1000000000)) (k (Int 0 100000)) (u (Int 0 12000)) (b Bool))
      (if (> c (allowance p))
        (= (admit (Request 1 p c (add s k)) (State s u b)) (err (Rejection TooLarge 0)))
        true)))

  (always "A request that would exceed the allowance is denied. The retry-after tells the caller how many whole seconds to wait until the next window can start: the time left until the current window's start plus 60 seconds, rounded up to a whole second, and never less than 1."
    (forall ((p Plan) (c (Int 1 12000)) (s (Int 0 1000000000)) (k (Int 0 59999)) (u (Int 0 12000)) (b Bool))
      (match (admit (Request 1 p c (add s k)) (State s u b))
        (ok d true)
        (err e (match e.reason
                 (TooLarge true)
                 (Denied (and (>= e.retryAfter 1)
                              (= e.retryAfter (div-floor (add (sub 60000 k) 999) 1000)))))))))

  (always "A Pro or Enterprise request that would otherwise be denied may borrow a burst on top of the allowance. The burst is 10% of the allowance, rounded down to whole tokens, and may be borrowed once per window, only if the request then fits within the allowance plus the burst. A request that borrows the burst says so in its answer. A Free request never borrows, and a request that fits within the allowance never uses the burst."
    (forall ((p Plan) (c (Int 1 12000)) (s (Int 0 1000000000)) (k (Int 0 59999)) (u (Int 0 12000)) (b Bool))
      (let [tot (add u c)
            a   (allowance p)
            cap (add a (div-floor a 10))]
        (match (admit (Request 1 p c (add s k)) (State s u b))
          (ok d (and (= d.burst (> tot a))
                     (or (not d.burst) (and (not b) (not (= p Free)) (<= tot cap)))))
          (err e (match e.reason
                   (TooLarge (> c a))
                   (Denied (and (> tot a) (<= c a) (or b (= p Free) (> tot cap))))))))))

  (privacy "The API key is never stored or written to the audit log. Changing it must not change anything stored or audited."
    (source Request.key)
    (allow)
    (run admit)))
